<h1>Lista de productos</h1>

<div class="products-grid">
  {{#each products}}
    <div class="product-card">
      <img src="{{this.thumbnail}}" alt="{{this.title}}" />

      <h3>{{this.title}}</h3>
      <p><strong>$ {{this.price}}</strong></p>
      <p class="product-id">ID: {{this.id}}</p>
    </div>
  {{/each}}
</div>